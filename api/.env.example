# PostgreSQL connection (matches ../docker-compose.yml)
DATABASE_URL="postgresql://spendly:spendly@localhost:5432/spendly?schema=public"

# Use a long random string in production, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed web origins
CORS_ORIGIN="http://localhost:3002"

PORT=4000
